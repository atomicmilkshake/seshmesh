<Window x:Class="Casr.App.Views.ConversionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Casr.App.Converters"
        mc:Ignorable="d"
        Title="SeshMesh — Convert Session"
        Height="680" Width="720"
        MinHeight="520" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBgBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ThemeCardAltBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeCardAltBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⇄ Convert Session" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeHighlightBrush}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Headline}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <TextBlock Text="Conversion" Style="{StaticResource SectionHeader}"/>
                <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding StatsLine}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0">
                            <Run Text="Resume command:"/>
                            <Run Text="{Binding ResumeCommandPreview, Mode=OneWay}" FontFamily="Consolas"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="Workspace" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Target workspace" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Workspace, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource ThemeCardAltBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                             BorderBrush="{DynamicResource ThemeBorderBrush}" Padding="6,4"
                             CaretBrush="{DynamicResource ThemeTextPrimaryBrush}"
                             ToolTip="Directory the target agent will open in (cwd-keyed providers find the session only from this directory)"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,-6,0,14" Visibility="{Binding HasGit, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Repository:  " Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding GitDisplay}" Foreground="{DynamicResource ThemeHighlightBrush}" ToolTip="{Binding GitRoot}"/>
                </StackPanel>

                <!-- Validation notes -->
                <StackPanel Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Blocking errors" Style="{StaticResource SectionHeader}"/>
                    <ItemsControl ItemsSource="{Binding Errors}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Warnings" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#F59E0B" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding HasInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                        <ItemsControl ItemsSource="{Binding Info}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Options -->
                <TextBlock Text="Options" Style="{StaticResource SectionHeader}"/>
                <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Enrich, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,4"
                                  ToolTip="Prepend a conversion notice and a recent-conversation snapshot so the target agent understands the handoff (casr --enrich)">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Add conversion context (enrich)" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Prepends a synthetic notice + recent-message snapshot." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding KeepReasoning, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,4"
                                  ToolTip="Keep the source agent's hidden reasoning traces (casr --keep-reasoning). Off by default: another agent's reasoning usually cannot be used.">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Keep reasoning traces" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Off drops the source agent's hidden reasoning before writing." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding Verify, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,4"
                                  ToolTip="Re-read the written session and compare it with what was written before launching (casr verification step). A count mismatch rolls the write back.">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Verify written session (read-back)" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Re-reads the output; a count mismatch rolls the conversion back." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </StackPanel>
                        </CheckBox>

                        <Grid Margin="6,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Max context tokens" Style="{StaticResource FieldLabel}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxContextTokensText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource ThemeCardAltBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ThemeBorderBrush}" Padding="4,2"
                                     CaretBrush="{DynamicResource ThemeTextPrimaryBrush}"
                                     ToolTip="Oldest middle turns are dropped first when the history exceeds this budget. 0 = use the target harness limit."/>
                            <TextBlock Grid.Column="3" Text="Max tool output (chars)" Style="{StaticResource FieldLabel}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="4" Text="{Binding MaxToolOutputText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource ThemeCardAltBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ThemeBorderBrush}" Padding="4,2"
                                     CaretBrush="{DynamicResource ThemeTextPrimaryBrush}"
                                     ToolTip="Each tool result is truncated to this many characters. 0 = only truncate when the harness limit is exceeded."/>
                        </Grid>
                        <TextBlock Text="0 = unlimited / harness default. Changing an option refreshes the preview above."
                                   FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="6,4,0,0"/>

                        <CheckBox IsChecked="{Binding LaunchAfter, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="6,8,0,0"
                                  ToolTip="Uncheck to only write the converted session; the resume command is copied to the clipboard instead of opening a terminal.">
                            <TextBlock Text="Launch the target agent after converting" FontSize="12"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,10,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📋 Copy report" Style="{StaticResource SecondaryButton}" Command="{Binding CopyReportCommand}" Margin="0,0,8,0"
                            ToolTip="Copy the conversion preview as a JSON report (casr --json analogue)"/>
                    <Button Content="↻ Refresh preview" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Content="{Binding ConvertButtonLabel}" Style="{StaticResource PrimaryButton}" Click="Convert_Click"
                            IsEnabled="{Binding CanConvert}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
