<Window x:Class="Casr.App.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Casr.App.ViewModels"
        xmlns:converters="clr-namespace:Casr.App.Converters"
        mc:Ignorable="d"
        Title="SeshMesh — Disaster Recovery &amp; Agent Backup Center"
        Height="620" Width="720"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing"
        Background="{DynamicResource ThemeBgBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ThemeCardAltBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeCardAltBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🛡️ Agent Disaster Recovery &amp; Backup Center" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                    <TextBlock Text="Safeguard conversations, custom skills, and configs from C-drive formatting or OS reinstalls."
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabbed Area -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: CREATE BACKUP -->
            <TabItem Header="💾 Create Snapshot" Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Padding="14,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <!-- Backup Destination -->
                        <TextBlock Text="Backup Destination Folder (e.g. Non-C: Drive)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource ThemeCardAltBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" Padding="8,6" FontSize="12.5"/>
                            <Button Grid.Column="1" Command="{Binding BrowseBackupDirCommand}" Content="Browse..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Protection Scope Checkboxes -->
                        <TextBlock Text="Included Agent Data &amp; Artifacts" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IncludeAntigravity}" Margin="0,4" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Antigravity (~/.gemini)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <TextBlock Text="Custom skills &amp; plugins (~/.gemini/config/plugins), conversation summaries, brain transcripts" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding IncludeCursor}" Margin="0,8,0,4" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Cursor (%APPDATA%\Cursor)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <TextBlock Text="All 630+ composer threads (globalStorage\state.vscdb), workspaceStorage bindings, settings" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding IncludeGrok}" Margin="0,8,0,4" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Grok CLI (~/.grok)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <TextBlock Text="Local CLI sessions, auth state, and configuration" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding IncludePi}" Margin="0,8,0,4" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Pi Coding Agent (~/.pi or PI_CODING_AGENT_DIR)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <TextBlock Text="Agent sessions, workspace bindings, and configuration" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding IncludeHermes}" Margin="0,8,0,4" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Hermes (HERMES_HOME or %LOCALAPPDATA%\hermes)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <TextBlock Text="state.db session database and saved sessions" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding IncludeOpenCode}" Margin="0,8,0,4" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="OpenCode (~/.local/share/opencode)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <TextBlock Text="opencode.db session database and data directory" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding IncludeOpenClaude}" Margin="0,8,0,4" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="OpenClaude (~/.openclaude)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <TextBlock Text="Projects, sessions, and configuration" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding IncludeCodex}" Margin="0,8,0,4" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Codex (~/.codex)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <TextBlock Text="Sessions, CLI configuration, and history" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding IncludeCasrDatabase}" Margin="0,8,0,4" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="SeshMesh local search index and settings" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <TextBlock Text="SQLite FTS5 full-text search index and application settings" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding IncludeCanonicalExport}" Margin="0,8,0,4" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Portable Canonical Export (JSON Archive)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <TextBlock Text="Human-readable standardized conversation JSON files independent of IDE databases" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Action Button -->
                        <Button Command="{Binding StartBackupCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="20,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦 " FontSize="14"/>
                                <TextBlock Text="Create Agent Backup Archive Now" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: RESTORE BACKUP -->
            <TabItem Header="🔄 Restore from Archive" Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Padding="14,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <TextBlock Text="Select a SeshMesh backup archive (.zip)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding RestoreZipPath, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource ThemeCardAltBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" Padding="8,6" FontSize="12.5"/>
                            <Button Grid.Column="1" Command="{Binding BrowseRestoreZipCommand}" Content="Browse Zip..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Manifest Details Card -->
                        <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Archive Inspection &amp; Manifest" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <ContentControl Grid.Column="1" Style="{StaticResource LoadingSpinnerStyle}" Width="16" Height="16"
                                                    Visibility="{Binding IsInspecting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>

                                <ProgressBar Height="3" Style="{StaticResource SlimProgressBarStyle}"
                                             IsIndeterminate="True" Margin="0,0,0,8"
                                             Visibility="{Binding IsInspecting, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <TextBlock Text="{Binding StatusTitle}" Foreground="{DynamicResource ThemeHighlightBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,0,0,10"/>

                                <CheckBox IsChecked="{Binding CreateRestoreBackupCopies}" Margin="0,4" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                          Content="Safely create .bak copies of existing files before replacing"/>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding StartRestoreCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="20,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀 " FontSize="14"/>
                                <TextBlock Text="Restore Agent State to Machine" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: STORAGE RELOCATION -->
            <TabItem Header="⚙️ Safe Storage &amp; Relocation" Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Padding="14,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <TextBlock Text="Relocate the live index database" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Store the index on another drive (for example D:\Backups\casr_index.db). The file name stays casr_index.db. If C: is wiped, the search index on that drive remains."
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <TextBlock Text="Custom Database Path:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding CustomDbPath, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource ThemeCardAltBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" Padding="8,6" FontSize="12.5"/>
                            <Button Grid.Column="1" Command="{Binding SaveStorageSettingsCommand}" Content="Save Path" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{Binding OperationResult}" Foreground="{DynamicResource ThemeHighlightBrush}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer Progress & Status -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                 IsIndeterminate="{Binding IsIndeterminateProgress}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Foreground="{DynamicResource ThemeAccentBrush}" Background="{DynamicResource ThemeCardAltBrush}" BorderThickness="0" Margin="0,0,14,6"/>
                    <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
